# =========================
# DATA STRUCTURES
# =========================
@dataclass
class Point:
    token_index: int
    time_index: int
    score: float


@dataclass
class SegmentSpan:
    label: str
    start: float
    end: float
    score: float


# =========================
# TEXT NORMALIZATION
# =========================
def normalize_text(text: str) -> str:
    text = text.lower().replace("—", "-").replace("–", "-")
    text = re.sub(KEEP_CHARS_REGEX, " ", text, flags=re.IGNORECASE)
    return re.sub(r"\s+", " ", text).strip()


def words_from_text(text: str) -> List[str]:
    return normalize_text(text).split()


def flatten_surface_word_mapping(text: str) -> List[Tuple[str, str]]:
    mapping = []
    for tok in text.split():
        norm_parts = normalize_text(tok).split()
        if not norm_parts:
            continue
        for part in norm_parts[:-1]:
            mapping.append((part, part))
        mapping.append((norm_parts[-1], tok))
    return mapping


def get_base_stem(path: str) -> str:
    stem = os.path.splitext(os.path.basename(path))[0]
    stem = re.sub(r"\s+", "_", stem)
    stem = re.sub(r"[^a-zA-Z0-9а-яөүһҕңёі_-]+", "", stem)
    return stem or "audio"


# =========================
# AUDIO SEGMENTATION
# =========================
def load_audio(path: str, target_sr: int = 16000) -> Tuple[np.ndarray, int]:
    wav, sr = librosa.load(path, sr=target_sr, mono=True)
    return wav.astype(np.float32), target_sr


def split_long_interval(start_s: float, end_s: float, max_len: float) -> List[Tuple[float, float]]:
    dur = end_s - start_s
    if dur <= max_len:
        return [(start_s, end_s)]
    chunk = dur / math.ceil(dur / max_len)
    result, cur = [], start_s
    while cur < end_s:
        nxt = min(end_s, cur + chunk)
        result.append((cur, nxt))
        cur = nxt
    return result


def get_speech_segments(
    wav: np.ndarray,
    sr: int,
    top_db: int,
    min_seg_sec: float,
    max_seg_sec: float,
    merge_gap_sec: float,
) -> List[Tuple[float, float]]:
    raw = librosa.effects.split(wav, top_db=top_db)
    if len(raw) == 0:
        return [(0.0, len(wav) / sr)]

    segments = [(s / sr, e / sr) for s, e in raw]

    merged = []
    cur_s, cur_e = segments[0]
    for s, e in segments[1:]:
        if s - cur_e <= merge_gap_sec:
            cur_e = e
        else:
            merged.append((cur_s, cur_e))
            cur_s, cur_e = s, e
    merged.append((cur_s, cur_e))

    cleaned = []
    for s, e in merged:
        if e - s < min_seg_sec:
            if cleaned:
                cleaned[-1] = (cleaned[-1][0], e)
            else:
                cleaned.append((s, e))
        else:
            cleaned.append((s, e))

    return [sub for s, e in cleaned for sub in split_long_interval(s, e, max_seg_sec)]


# =========================
# MODEL UTILITIES
# =========================
def load_model_and_processor(model_name: str):
    processor = Wav2Vec2Processor.from_pretrained(model_name)
    model = Wav2Vec2ForCTC.from_pretrained(model_name).to(DEVICE)
    model.eval()
    return processor, model


def get_vocab_maps(processor: Wav2Vec2Processor):
    vocab = processor.tokenizer.get_vocab()
    id_to_token = {idx: tok for tok, idx in vocab.items()}

    blank_id = processor.tokenizer.pad_token_id
    if blank_id is None:
        raise ValueError("Tokenizer has no pad_token_id.")

    word_delim = getattr(processor.tokenizer, "word_delimiter_token", "|")
    if word_delim not in vocab:
        if "|" in vocab:
            word_delim = "|"
        else:
            raise ValueError("Could not find word delimiter token.")

    return vocab, id_to_token, blank_id, word_delim


def encode_text_for_ctc(text: str, vocab: Dict[str, int], word_delim: str) -> Tuple[List[int], List[str]]:
    chars, token_ids = [], []
    for ch in normalize_text(text):
        tok = word_delim if ch == " " else ch
        if tok in vocab:
            chars.append(tok)
            token_ids.append(vocab[tok])
    return token_ids, chars


def decode_greedy(processor: Wav2Vec2Processor, logits: torch.Tensor) -> str:
    pred_ids = torch.argmax(logits, dim=-1)
    return normalize_text(processor.batch_decode(pred_ids)[0])


def infer_emission(wav_segment: np.ndarray, processor, model, sr: int = 16000) -> torch.Tensor:
    inputs = processor(wav_segment, sampling_rate=sr, return_tensors="pt", padding=True)
    with torch.no_grad():
        logits = model(inputs.input_values.to(DEVICE)).logits[0].cpu()
    return torch.log_softmax(logits, dim=-1)


# =========================
# CTC TRELLIS ALIGNMENT
# =========================
def build_trellis(emission: torch.Tensor, tokens: List[int], blank_id: int) -> torch.Tensor:
    T, N = emission.size(0), len(tokens)
    trellis = torch.full((T + 1, N + 1), -float("inf"))
    trellis[0, 0] = 0.0
    trellis[1:, 0] = torch.cumsum(emission[:, blank_id], dim=0)

    token_tensor = torch.tensor(tokens, dtype=torch.long)

    for t in range(T):
        stay = trellis[t, 1:] + emission[t, blank_id]
        change = trellis[t, :-1] + emission[t, token_tensor]
        trellis[t + 1, 1:] = torch.maximum(stay, change)

    return trellis


def backtrack(trellis: torch.Tensor, emission: torch.Tensor, tokens: List[int], blank_id: int) -> List[Point]:
    T, N = trellis.size(0) - 1, trellis.size(1) - 1
    if N == 0:
        return []

    t = int(torch.argmax(trellis[:, N]).item())
    j = N
    path: List[Point] = []

    while j > 0:
        if t <= 0:
            raise ValueError("Backtracking failed: ran out of time steps.")

        p_stay = trellis[t - 1, j] + emission[t - 1, blank_id]
        p_change = trellis[t - 1, j - 1] + emission[t - 1, tokens[j - 1]]

        if p_change > p_stay:
            path.append(Point(
                token_index=j - 1,
                time_index=t - 1,
                score=float(emission[t - 1, tokens[j - 1]].exp())
            ))
            j -= 1
        t -= 1

    path.reverse()
    return path


def merge_repeats(path: List[Point], token_symbols: List[str], frame_sec: float) -> List[SegmentSpan]:
    segments = []
    i = 0
    while i < len(path):
        j = i + 1
        while j < len(path) and path[j].token_index == path[i].token_index:
            j += 1

        seg = path[i:j]
        segments.append(
            SegmentSpan(
                label=token_symbols[path[i].token_index],
                start=path[i].time_index * frame_sec,
                end=(path[j - 1].time_index + 1) * frame_sec,
                score=sum(p.score for p in seg) / len(seg),
            )
        )
        i = j
    return segments


def char_segments_to_word_segments(char_segments: List[SegmentSpan], word_delim: str) -> List[SegmentSpan]:
    words = []
    buf_chars, buf_scores = [], []
    w_start, w_end = None, None

    for seg in char_segments:
        if seg.label == word_delim:
            if buf_chars:
                words.append(SegmentSpan(
                    label="".join(buf_chars),
                    start=w_start,
                    end=w_end,
                    score=sum(buf_scores) / len(buf_scores),
                ))
                buf_chars, buf_scores = [], []
                w_start, w_end = None, None
            continue

        if w_start is None:
            w_start = seg.start
        w_end = seg.end
        buf_chars.append(seg.label)
        buf_scores.append(seg.score)

    if buf_chars:
        words.append(SegmentSpan(
            label="".join(buf_chars),
            start=w_start,
            end=w_end,
            score=sum(buf_scores) / len(buf_scores),
        ))

    return words


# =========================
# SAFETY HELPERS
# =========================
def trim_ref_text_to_emission_capacity(
    text: str,
    emission: torch.Tensor,
    vocab: Dict[str, int],
    word_delim: str,
    safety_ratio: float = 0.85,
    max_words: int = 80,
) -> str:
    words = words_from_text(text)[:max_words]
    if not words:
        return text

    max_tokens = max(1, int(emission.size(0) * safety_ratio))
    kept = []

    for w in words:
        candidate = " ".join(kept + [w])
        token_ids, _ = encode_text_for_ctc(candidate, vocab, word_delim)
        if len(token_ids) <= max_tokens:
            kept.append(w)
        else:
            break

    return words[0] if not kept else " ".join(kept)


def map_normalized_words_to_surface(
    words_norm: List[str],
    surface_pairs: List[Tuple[str, str]],
    start_idx: int
) -> Tuple[List[str], int]:
    surface_out = []
    i = start_idx

    for wn in words_norm:
        while i < len(surface_pairs):
            norm_tok, surface_tok = surface_pairs[i]
            i += 1
            if norm_tok == wn:
                surface_out.append(surface_tok)
                break
        else:
            surface_out.append(wn)

    return surface_out, i


def build_sentence_segments(word_segments_punct: List[SegmentSpan]) -> List[SegmentSpan]:
    sentences = []
    cur_tokens, cur_scores = [], []
    cur_start, cur_end = None, None

    for i, ws in enumerate(word_segments_punct):
        if cur_start is None:
            cur_start = ws.start

        cur_tokens.append(ws.label)
        cur_scores.append(ws.score)
        cur_end = ws.end

        next_gap = None
        if i < len(word_segments_punct) - 1:
            next_gap = word_segments_punct[i + 1].start - ws.end

        cur_duration = cur_end - cur_start
        force_break = (
            (next_gap is not None and next_gap >= LONG_PAUSE_FOR_SENT_BOUNDARY and cur_duration >= 2.0)
            or cur_duration >= MAX_SENTENCE_DURATION
        )

        if SENTENCE_END_RE.search(ws.label) or force_break:
            sentences.append(SegmentSpan(
                label=" ".join(cur_tokens),
                start=cur_start,
                end=cur_end,
                score=sum(cur_scores) / len(cur_scores),
            ))
            cur_tokens, cur_scores = [], []
            cur_start, cur_end = None, None

    if cur_tokens:
        sentences.append(SegmentSpan(
            label=" ".join(cur_tokens),
            start=cur_start,
            end=cur_end,
            score=sum(cur_scores) / len(cur_scores),
        ))

    return sentences


def export_sentence_wavs(
    wav: np.ndarray,
    sr: int,
    sentence_segments: List[SegmentSpan],
    out_dir: str,
    base_stem: str,
    pad_sec: float = 0.05,
    zero_pad: int = 5,
) -> None:
    for i, seg in enumerate(sentence_segments, start=1):
        start = max(0.0, seg.start - pad_sec)
        end = min(len(wav) / sr, seg.end + pad_sec)

        chunk = wav[int(round(start * sr)):int(round(end * sr))]
        sent_id = f"{base_stem}_{i:0{zero_pad}d}"

        wav_path = os.path.join(out_dir, f"{sent_id}.wav")
        txt_path = os.path.join(out_dir, f"{sent_id}.txt")

        sf.write(wav_path, chunk, sr)
        with open(txt_path, "w", encoding="utf-8") as f:
            f.write(seg.label.strip() + "\n")


# =========================
# FAST ALIGNMENT WRAPPER
# =========================
def align_with_existing_emission(
    emission: torch.Tensor,
    wav_segment: np.ndarray,
    ref_text: str,
    processor,
    vocab: Dict[str, int],
    blank_id: int,
    word_delim: str,
    sr: int = 16000,
) -> Tuple[List[SegmentSpan], str, str, bool]:
    greedy_text = decode_greedy(processor, emission.unsqueeze(0))

    safe_text = trim_ref_text_to_emission_capacity(
        text=ref_text,
        emission=emission,
        vocab=vocab,
        word_delim=word_delim,
        safety_ratio=CTC_SAFETY_RATIO,
        max_words=MAX_WORDS_PER_SEGMENT,
    )

    token_ids, token_symbols = encode_text_for_ctc(safe_text, vocab, word_delim)
    if not token_ids:
        return [], greedy_text, safe_text, False

    trellis = build_trellis(emission, token_ids, blank_id)

    try:
        path = backtrack(trellis, emission, token_ids, blank_id)
    except ValueError:
        return [], greedy_text, safe_text, False

    if not path:
        return [], greedy_text, safe_text, False

    frame_sec = len(wav_segment) / sr / emission.size(0)
    char_segments = merge_repeats(path, token_symbols, frame_sec)
    word_segments = char_segments_to_word_segments(char_segments, word_delim)

    return word_segments, greedy_text, safe_text, bool(word_segments)


# =========================
# TRANSCRIPT MATCHING
# =========================
def best_reference_slice(
    pred_text: str,
    ref_words: List[str],
    start_idx: int,
    search_extra: int = 20,
    search_multiplier: float = 2.2,
) -> Tuple[int, int, float]:
    pred_words = words_from_text(pred_text)
    if not pred_words:
        return start_idx, min(start_idx + 1, len(ref_words)), 0.0

    target_len = len(pred_words)
    min_len = max(1, int(target_len * 0.5))
    max_len = int(target_len * search_multiplier) + search_extra
    max_end = min(len(ref_words), start_idx + max_len)

    best = (start_idx, min(len(ref_words), start_idx + min_len), -1.0)

    for end_idx in range(start_idx + min_len, max_end + 1):
        candidate = " ".join(ref_words[start_idx:end_idx])
        score = difflib.SequenceMatcher(None, pred_text, candidate).ratio()
        if score > best[2]:
            best = (start_idx, end_idx, score)

    return best


# =========================
# MAIN
# =========================
def main():
    print(f"Using device: {DEVICE}")

    print("Loading audio...")
    wav, sr = load_audio(AUDIO_PATH, TARGET_SR)
    total_duration = len(wav) / sr

    print("Loading transcript...")
    with open(TRANSCRIPT_PATH, "r", encoding="utf-8") as f:
        transcript_raw = f.read()

    ref_words = normalize_text(transcript_raw).split()
    surface_pairs = flatten_surface_word_mapping(transcript_raw)

    print("Loading model...")
    processor, model = load_model_and_processor(MODEL_NAME)
    vocab, _, blank_id, word_delim = get_vocab_maps(processor)

    print("Segmenting audio by pauses...")
    speech_segments = get_speech_segments(
        wav=wav,
        sr=sr,
        top_db=TOP_DB,
        min_seg_sec=MIN_SEGMENT_SEC,
        max_seg_sec=MAX_SEGMENT_SEC,
        merge_gap_sec=MERGE_GAP_SEC,
    )
    print(f"Detected {len(speech_segments)} speech segments")

    aligned_words_norm_all: List[SegmentSpan] = []
    aligned_words_punct_all: List[SegmentSpan] = []

    ref_idx = 0
    surface_idx = 0

    for seg_i, (seg_start, seg_end) in enumerate(speech_segments):
        wav_seg = wav[int(seg_start * sr):int(seg_end * sr)]

        if len(wav_seg) < int(MIN_AUDIO_SEC_FOR_ALIGNMENT * sr):
            continue

        print(f"[{seg_i+1}/{len(speech_segments)}] {seg_start:.2f}-{seg_end:.2f}s")

        # SINGLE inference per segment
        emission = infer_emission(wav_seg, processor, model, sr=sr)
        pred_text = decode_greedy(processor, emission.unsqueeze(0))

        start_idx, end_idx, _ = best_reference_slice(
            pred_text=pred_text,
            ref_words=ref_words,
            start_idx=ref_idx,
            search_extra=SEARCH_EXTRA_WORDS,
            search_multiplier=SEARCH_MULTIPLIER,
        )

        ref_slice_text = " ".join(ref_words[start_idx:end_idx])
        if not ref_slice_text.strip():
            continue

        word_segments, _, used_ref_text, success = align_with_existing_emission(
            emission=emission,
            wav_segment=wav_seg,
            ref_text=ref_slice_text,
            processor=processor,
            vocab=vocab,
            blank_id=blank_id,
            word_delim=word_delim,
            sr=sr,
        )

        used_ref_words = words_from_text(used_ref_text)
        used_surface_tokens, new_surface_idx = map_normalized_words_to_surface(
            used_ref_words,
            surface_pairs,
            surface_idx,
        )

        for i, ws in enumerate(word_segments):
            punct_label = used_surface_tokens[i] if i < len(used_surface_tokens) else ws.label

            shifted_norm = SegmentSpan(
                label=ws.label,
                start=ws.start + seg_start,
                end=ws.end + seg_start,
                score=ws.score,
            )
            shifted_punct = SegmentSpan(
                label=punct_label,
                start=ws.start + seg_start,
                end=ws.end + seg_start,
                score=ws.score,
            )

            aligned_words_norm_all.append(shifted_norm)
            aligned_words_punct_all.append(shifted_punct)

        if success and word_segments:
            ref_idx = min(start_idx + len(used_ref_words), len(ref_words))
            surface_idx = new_surface_idx

        if ref_idx >= len(ref_words):
            break

    sentence_segments = build_sentence_segments(aligned_words_punct_all)

    base_stem = get_base_stem(AUDIO_PATH)

    export_sentence_wavs(
        wav=wav,
        sr=sr,
        sentence_segments=sentence_segments,
        out_dir=SENTENCE_WAV_DIR,
        base_stem=base_stem,
        pad_sec=SENTENCE_PAD_SEC,
        zero_pad=SENTENCE_ZERO_PAD,
    )

    words_txt_path = os.path.join(OUTPUT_DIR, f"{base_stem}_words.txt")
    with open(words_txt_path, "w", encoding="utf-8") as f:
        for w in aligned_words_norm_all:
            f.write(f"{w.start:.3f}\t{w.end:.3f}\t{w.label}\n")

    sentences_txt_path = os.path.join(OUTPUT_DIR, f"{base_stem}_sentences.txt")
    with open(sentences_txt_path, "w", encoding="utf-8") as f:
        for s in sentence_segments:
            f.write(f"{s.start:.3f}\t{s.end:.3f}\t{s.label}\n")

    tg = TextGrid(minTime=0.0, maxTime=total_duration)
    word_tier = IntervalTier(name="words_norm", minTime=0.0, maxTime=total_duration)
    sent_tier = IntervalTier(name="sentences_punct", minTime=0.0, maxTime=total_duration)

    for w in aligned_words_norm_all:
        if w.end > w.start:
            word_tier.add(w.start, w.end, w.label)

    for s in sentence_segments:
        if s.end > s.start:
            sent_tier.add(s.start, s.end, s.label)

    tg.append(word_tier)
    tg.append(sent_tier)

    textgrid_path = os.path.join(OUTPUT_DIR, f"{base_stem}.TextGrid")
    tg.write(textgrid_path)

    print("\nDone.")
    print("Saved:")
    print(words_txt_path)
    print(sentences_txt_path)
    print(textgrid_path)
    print(SENTENCE_WAV_DIR)


if __name__ == "__main__":
    main()
